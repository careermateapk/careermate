rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isCollector() {
      return request.auth != null
        && request.auth.token.email == 'aggarwal97kajal+careermate-collector@gmail.com';
    }

    // Each user's own data
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Jobs: any signed-in user can read; only the job collector can write
    match /jobs_index/{doc} {
      allow read: if request.auth != null;
      allow write: if isCollector();
    }
    match /meta/{doc} {
      allow read: if request.auth != null;
      allow write: if isCollector();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Each user can read and write only their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'authProvider', 'createdAt']);

      match /resumes/{resumeId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes <= 5 * 1024 * 1024
          && request.resource.data.status == 'uploaded';
        // The app only flips isCurrent; parsing status will be set by the server later.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCurrent']);
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
